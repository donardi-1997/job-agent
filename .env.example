# Browser Use / Job Agent Configuration
# Copy this file to .env if you want local overrides.

# Logging Configuration
BROWSER_USE_LOGGING_LEVEL=info
BROWSER_USE_DEBUG_LOG_FILE=debug.log
BROWSER_USE_INFO_LOG_FILE=info.log
CDP_LOGGING_LEVEL=WARNING

# Telemetry and Analytics
ANONYMIZED_TELEMETRY=true

# ---------------------------------------------------------------------------
# JOB AGENT ZERO-COST POLICY
# ---------------------------------------------------------------------------
# Default: ON. While this is 1, Job Agent forces every paid Browser Use AI path
# off and shadows BROWSER_USE_API_KEY inside the process. Search, form reading,
# answer reuse and application navigation run locally through Chrome/CDP.
JOB_AGENT_ZERO_COST=1
JOB_AGENT_SEARCH_AI_FALLBACK=0
JOB_AGENT_QUESTION_LLM=0
JOB_AGENT_APPLICATION_AI_FALLBACK=0

# No Browser Use API key is required in zero-cost mode.
# If you intentionally launch with `python run_job_agent.py --allow-paid-ai`,
# you may provide a key and selectively enable the fallbacks below.
BROWSER_USE_API_KEY=

# Optional paid-mode limits/settings. They are inert while JOB_AGENT_ZERO_COST=1.
JOB_AGENT_SEARCH_AI_MAX_STEPS=20
JOB_AGENT_QUESTION_MODEL=bu-2-0
JOB_AGENT_APPLICATION_AI_MAX_STEPS=18
JOB_AGENT_BROWSER_MODEL=bu-latest

# Local estimated cost display conversion for historical/optional paid usage.
JOB_AGENT_USD_COP_RATE=4000

# Optional Browser Use Cloud/API configuration for explicit paid mode only.
# BROWSER_USE_CLOUD_API_URL=https://api.browser-use.com
# BROWSER_USE_CLOUD_SYNC=false

# Optional third-party LLM providers. Job Agent's zero-cost flow does not need them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# GROK_API_KEY=
# NOVITA_API_KEY=
# ORCAROUTER_API_KEY=

# AWS Bedrock Configuration (optional, not used by zero-cost Job Agent)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# Browser Configuration
# BROWSER_USE_EXECUTABLE_PATH=/path/to/chrome
# BROWSER_USE_HEADLESS=false
# BROWSER_USE_USER_DATA_DIR=./browser_data

# Proxy Configuration (optional; leave unset for zero-cost local usage)
# BROWSER_USE_PROXY_SERVER=
# BROWSER_USE_NO_PROXY=localhost,127.0.0.1,*.internal
# BROWSER_USE_PROXY_USERNAME=
# BROWSER_USE_PROXY_PASSWORD=

BROWSER_USE_VERSION_CHECK=true
